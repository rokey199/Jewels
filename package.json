{
  "name": "maison-doree",
  "private": true,
  "version": "1.0.0",
  "description": "Maison Dorée — luxury jewellery e-commerce",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
